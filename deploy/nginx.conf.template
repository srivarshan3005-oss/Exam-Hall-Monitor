# Rendered by the nginx image from environment variable DOMAIN_NAME (set in backend/.env.production; only that variable
# is substituted, nginx's own $variables are untouched). Install the matching TLS certificate/key in deploy/certs/.
# Nginx is the only published application ingress. The API container is private.
server_tokens off;

server {
    listen 80;
    server_name ${DOMAIN_NAME};
    # ACME HTTP-01 challenge directory. Only used if you obtain certificates with certbot webroot mode; mount a host
    # directory at /var/www/certbot on the proxy service in docker-compose.yml first. Otherwise this location is inert.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    client_max_body_size 30m;
    # The application sets the same security headers; hide its copies so each header is sent once.
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    location / {
        proxy_pass http://app:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
    }
}
