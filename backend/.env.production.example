# Copy to backend/.env.production and set unique random values before deployment.
COLLEGE_NAME=Your College Name
ENVIRONMENT=production
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
# docker-compose.yml builds the real DATABASE_URL from POSTGRES_PASSWORD and overrides this line; it is kept only for
# running app.cli outside Compose. Use only letters/digits in POSTGRES_PASSWORD (or URL-encode it everywhere).
DATABASE_URL=postgresql+psycopg://exam_monitor:SET_POSTGRES_PASSWORD@db:5432/exam_monitor
POSTGRES_PASSWORD=SET_A_LONG_RANDOM_DATABASE_PASSWORD
# Public host name WITHOUT scheme or path (e.g. exams.yourcollege.edu). docker-compose.yml derives PUBLIC_BASE_URL, CORS_ORIGINS
# and the Nginx server_name from it. The two lines below are only for running app.cli outside Compose.
DOMAIN_NAME=SET_YOUR_DOMAIN_NAME
CORS_ORIGINS=https://SET_YOUR_DOMAIN_NAME
PUBLIC_BASE_URL=https://SET_YOUR_DOMAIN_NAME
ENABLE_DOCS=false
TRUST_PROXY=true
SEED_DEMO=false
ALLOW_SELF_REGISTRATION=false
PUBLIC_SHOW_NAMES=false
PUBLIC_RESULTS_ENABLED=false
SCHEDULER_ENABLED=true
# Keep false until pg_dump (PostgreSQL 16 client) is available to the app container; PostgreSQL backups fail without it.
BACKUP_SCHEDULE_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
DOCUMENT_STORAGE_DIR=/app/uploads
APP_TIMEZONE=Asia/Kolkata
# SMTP (needed for activation / password-reset e-mail). SMTP_SECURITY: starttls (port 587), ssl (465) or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Exam Monitor
