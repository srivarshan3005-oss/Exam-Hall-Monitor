# Copy to .env (or run: python -m app.cli init-env). NEVER commit .env.
COLLEGE_NAME=Your College Name
ENVIRONMENT=development
# Required. Minimum 32 random characters. `python -m app.cli init-env` generates one for you.
SECRET_KEY=
DATABASE_URL=sqlite:///./exam_monitor.db
# PostgreSQL instead (also: pip install -r requirements-postgres.txt; create an EMPTY database first):
#   DATABASE_URL=postgresql://exam_monitor:CHANGE_ME@localhost:5432/exam_monitor
# Optional connection tuning (defaults shown). See docs/DATABASE.md.
#   SQLITE_BUSY_TIMEOUT_MS=15000   SQLITE_WAL=true   MIGRATION_SNAPSHOT=true
#   DB_POOL_SIZE=5   DB_MAX_OVERFLOW=10   DB_POOL_TIMEOUT_SECONDS=30   DB_POOL_RECYCLE_SECONDS=1800   DB_STATEMENT_TIMEOUT_MS=0
ACCESS_TOKEN_MINUTES=60

# Demo data (synthetic students/exam only; never creates a login). Keep false in production.
SEED_DEMO=false

# Privacy switches for the public student search
PUBLIC_SHOW_NAMES=false
PUBLIC_RESULTS_ENABLED=false

# Web
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ENABLE_DOCS=true
# Set true ONLY behind a reverse proxy you control (it must overwrite X-Forwarded-For)
TRUST_PROXY=false

# Login protection
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=20
# Public lookup protection (per client IP). Campus Wi-Fi shares one IP: raise these if students are blocked.
PUBLIC_LOOKUP_PER_MINUTE=60
PUBLIC_LOOKUP_MISS_LIMIT=30

# Phase 3 document processing
# DOCUMENT_STORAGE_DIR=            # blank = backend/uploads (keep outside any public web directory)
# MAX_UPLOAD_MB=25
# OCR_DEFAULT_LANGUAGE=eng         # e.g. eng or tam+eng (language packs must be installed)

# Phase 4: sessions, recovery and mail
# SESSION_IDLE_MINUTES=30           # unused sessions are rejected after this long
# MAX_SESSIONS_PER_USER=5
# RESET_TOKEN_MINUTES=30
# ACTIVATION_TOKEN_HOURS=48
# ALLOW_SELF_REGISTRATION=true      # students only; needs the e-mail on their student record + activation
# PASSWORD_MAX_AGE_DAYS=0           # 0 = never force a password change
# PUBLIC_BASE_URL=http://localhost:8000   # used in reset/activation links (https:// required in production)
# SMTP_HOST=                        # blank: development writes messages to the outbox folder, production logs only
# MAIL_OUTBOX_DIR=                  # optional outbox folder for development/test mail (blank = backend/outbox). Example: C:\ExamMonitorOutbox
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@your-college.example

# Phase 6: notifications, e-mail delivery, reminders
# SMTP_SECURITY=starttls            # starttls (port 587) | ssl (port 465) | none (local relays only)
# SMTP_FROM_NAME=Exam Monitor
# SMTP_TIMEOUT_SECONDS=15
# MAIL_MAX_ATTEMPTS=3               # attempts for queued notification e-mail
# MAIL_RETRY_BACKOFF_SECONDS=120    # doubles after each failed attempt
# APP_TIMEZONE=Asia/Kolkata         # exam dates/times are local to this IANA zone (default Asia/Kolkata)
# PORTAL_PAST_DAYS=-1                # -1 = keep every stored exam (default); the page shows upcoming exams, else only the latest previous one
# VSB_POLL_SECONDS=60               # scan interval in seconds (15-300); unchanged PDFs are not re-downloaded (ETag/Last-Modified)
# SCHEDULER_ENABLED=true            # background worker thread: reminders, scheduled announcements, e-mail queue
# SCHEDULER_INTERVAL_SECONDS=60
# REMINDERS_ENABLED=true
# REMINDER_EXAM_HOURS=24            # comma list, e.g. 72,24,2 = remind that many hours before an exam
# TEST_EMAIL_PER_HOUR=5
# Put SMTP_USER / SMTP_PASSWORD only in backend/.env (never commit it).

# Phase 8.2: database backup policy
# BACKUP_SCHEDULE_ENABLED=false
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_COUNT=14

# Official V.S.B. Engineering College integration (all optional; defaults shown). See docs/VSB_INTEGRATION.md
# VSB_COE_PAGE_URL=https://vsbec.edu.in/controller-of-examination/
VSB_AUTO_DISCOVER_ENABLED=true     # true = the scheduler checks the official page and downloads new PDFs
# VSB_DISCOVER_INTERVAL_HOURS=6
# VSB_HTTP_TIMEOUT_SECONDS=20
# VSB_REQUEST_DELAY_SECONDS=1.0
# VSB_MAX_DOWNLOADS_PER_RUN=40
# VSB_MAX_RETRIES=2
VSB_STAGE_DRAFTS_ON_SCHEDULE=true  # true = scheduled runs also parse new hall+seat PDFs into DRAFT allocation batches (never published)
# VSB_PUBLIC_LOOKUP=true              # show PUBLISHED, approved VSB seats in the public register-number lookup (false = signed-in students only)

# ---------------------------------------------------------------------------------------------------------------------------
# V7 live monitoring (all optional; defaults shown) - see docs/LIVE_MONITORING.md and docs/ENVIRONMENT.md
# ---------------------------------------------------------------------------------------------------------------------------
# VSB_POLL_MINUTES=5                  # automatic scan interval; clamped to 5..1440 (never hammers the college server)
# VSB_SCAN_ON_STARTUP=true            # the first cycle after the server starts always scans
# VSB_EXTRA_PAGES=https://coe.vsbec.edu.in/    # additional official listing pages (comma separated; allow-listed hosts only)
# VSB_WP_DISCOVERY=true               # WordPress REST media/search endpoints (public, read-only)
# VSB_SITEMAP_DISCOVERY=true          # public XML sitemaps
# VSB_MAX_DOWNLOAD_MB=40              # per-PDF size limit
# VSB_AUTO_PUBLISH=true               # parsed allotments are searchable without an administrator publishing step
# PUBLIC_PAGE_DPI=130                 # resolution of the original-page image
# PREVIEW_CACHE_VERSION=v2-unmasked   # change to invalidate every cached page image
# SESSION_TIMES=FN=09:30-12:30,AN=13:30-16:30   # shown to students only when set; the PDFs do not print session times
# NOTIFY_WATCH_ENABLED=true           # administrator-managed register-number e-mail watch list
# Optional Supabase mirror (backend only; the service key never goes to a browser):
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_TABLE=live_allotments
